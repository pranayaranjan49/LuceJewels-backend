NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/jewelry_db

JWT_SECRET=replace_with_long_random_string
JWT_EXPIRE=7d

# Nodemailer (Gmail example - use App Password, not real password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=youremail@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="Royal Jewels <youremail@gmail.com>"

# Twilio (OPTIONAL - leave these blank/commented out to disable phone login entirely).
# The server boots fine without them. Email OTP login, products, orders, and everything
# else works normally. Only phone-channel login and SMS campaigns need these.
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Admin bootstrap (used by seed script)
ADMIN_EMAIL=admin@royaljewels.com
ADMIN_PASSWORD=Admin@12345
